new file mode 100644
index 0000000..bcffcac
--- /dev/null
+++ b/internal/store/app_metadata.go
@@ -0,0 +1,75 @@
+package store
+
+import (
+	"iter"
+	"maps"
+	"slices"
+)
+
+type AppMetadata struct {
+	root   *[shardFanout]map[string][]byte
+	cloned [shardFanout / 64]uint64
+}
+
+func NewAppMetadata() AppMetadata              { return AppMetadata{root: new([shardFanout]map[string][]byte)} }
+func (metadata AppMetadata) Fork() AppMetadata { return AppMetadata{root: metadata.root} }
+
+func (metadata AppMetadata) Clone() AppMetadata {
+	cloned := NewAppMetadata()
+	for key, value := range metadata.All() {
+		cloned.Set(key, slices.Clone(value))
+	}
+	return cloned
+}
+func (metadata AppMetadata) Get(key string) ([]byte, bool) {
+	if metadata.root == nil {
+		return nil, false
+	}
+	value, ok := metadata.root[uint8(hashString(key))][key]
+	return value, ok
+}
+func (metadata *AppMetadata) Set(key string, value []byte) {
+	shard := uint8(hashString(key))
+	metadata.cloneShard(shard)
+	metadata.root[shard][key] = value
+}
+func (metadata *AppMetadata) Delete(key string) {
+	shard := uint8(hashString(key))
+	if metadata.root == nil || metadata.root[shard] == nil {
+		return
+	}
+	metadata.cloneShard(shard)
+	delete(metadata.root[shard], key)
+}
+func (metadata AppMetadata) All() iter.Seq2[string, []byte] {
+	return func(yield func(string, []byte) bool) {
+		if metadata.root == nil {
+			return
+		}
+		for _, shard := range metadata.root {
+			for key, value := range shard {
+				if !yield(key, value) {
+					return
+				}
+			}
+		}
+	}
+}
+func (metadata *AppMetadata) cloneShard(shard uint8) {
+	if metadata.root == nil {
+		metadata.root = new([shardFanout]map[string][]byte)
+	}
+	word, bit := shard/64, uint64(1)<<(shard%64)
+	if metadata.cloned[word]&bit != 0 {
+		return
+	}
+	root := new([shardFanout]map[string][]byte)
+	*root = *metadata.root
+	metadata.root = root
+	if current := root[shard]; current != nil {
+		root[shard] = maps.Clone(current)
+	} else {
+		root[shard] = map[string][]byte{}
+	}
+	metadata.cloned[word] |= bit
+}
