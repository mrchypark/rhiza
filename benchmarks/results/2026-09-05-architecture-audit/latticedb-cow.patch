+++ b/internal/store/app_metadata_test.go
@@ -0,0 +1,32 @@
+package store
+
+import "testing"
+
+func TestAppMetadataForkClonesOnlyTouchedShard(t *testing.T) {
+	first := "first"
+	second := ""
+	for candidate := 0; ; candidate++ {
+		key := string(rune(candidate))
+		if key != first && uint8(hashString(key)) == uint8(hashString(first)) {
+			second = key
+			break
+		}
+	}
+	metadata := NewAppMetadata()
+	metadata.Set(first, []byte("base"))
+	fork := metadata.Fork()
+	fork.Set(second, []byte("fork"))
+	fork.Set(first, []byte("changed"))
+	if value, _ := metadata.Get(first); string(value) != "base" {
+		t.Fatalf("base value = %q", value)
+	}
+	if _, ok := metadata.Get(second); ok {
+		t.Fatal("base acquired fork-only value")
+	}
+	if value, _ := fork.Get(first); string(value) != "changed" {
+		t.Fatalf("fork value = %q", value)
+	}
+	if value, _ := fork.Get(second); string(value) != "fork" {
+		t.Fatalf("fork collision value = %q", value)
+	}
+}
