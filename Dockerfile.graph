FROM debian:bookworm-slim AS lattice-builder
ARG TARGETARCH
ARG LATTICEDB_REF=8ef87c915c66578b87ed02333233902379df2877
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git xz-utils && rm -rf /var/lib/apt/lists/*
RUN case "$TARGETARCH" in amd64) zig_arch=x86_64 ;; arm64) zig_arch=aarch64 ;; *) exit 1 ;; esac && \
    curl -fsSL "https://ziglang.org/download/0.16.0/zig-${zig_arch}-linux-0.16.0.tar.xz" | tar -xJ -C /opt && \
    ln -s "/opt/zig-${zig_arch}-linux-0.16.0/zig" /usr/local/bin/zig
RUN git clone https://github.com/mrchypark/latticedb.git /src/latticedb && \
    cd /src/latticedb && git checkout "$LATTICEDB_REF" && \
    zig build shared -Doptimize=ReleaseFast --prefix /opt/lattice

FROM golang:1.27-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends gcc git libc6-dev pkg-config && rm -rf /var/lib/apt/lists/*
COPY --from=lattice-builder /opt/lattice /opt/lattice
ENV PKG_CONFIG_PATH=/opt/lattice/lib/pkgconfig
ENV LD_LIBRARY_PATH=/opt/lattice/lib
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOEXPERIMENT=arenas,greenteagc go test -tags=graph ./... && \
    CGO_ENABLED=1 GOEXPERIMENT=arenas,greenteagc go build -tags=graph -o rhiza ./cmd/rhiza

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/* && \
    useradd --no-create-home --uid 65532 rhiza && mkdir -p /data && chown 65532:65532 /data
COPY --from=lattice-builder /opt/lattice/lib/liblattice.so /usr/local/lib/liblattice.so
COPY --from=builder /app/rhiza /usr/local/bin/rhiza
WORKDIR /data
ENV LD_LIBRARY_PATH=/usr/local/lib
ENV RHIZA_DATA_DIR=/data
VOLUME ["/data"]
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["rhiza"]
