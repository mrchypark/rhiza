FROM golang:1.27-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOEXPERIMENT=arenas,greenteagc go test -tags=graph ./... && \
    CGO_ENABLED=0 GOEXPERIMENT=arenas,greenteagc go build -tags=graph -o rhiza ./cmd/rhiza

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
COPY --from=builder /app/rhiza /usr/local/bin/rhiza
EXPOSE 8080
ENTRYPOINT ["rhiza"]
