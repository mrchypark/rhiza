FROM golang:1.27-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o rhiza-operator ./cmd/rhiza-operator

FROM alpine:3.19

RUN apk --no-cache add ca-certificates && adduser -D -u 65532 rhiza

COPY --from=builder /app/rhiza-operator /usr/local/bin/rhiza-operator

USER 65532:65532

ENTRYPOINT ["rhiza-operator"]
