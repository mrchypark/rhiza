# Render only through bootstrap-gcs-postrelease.sh. Admin creates; CI cannot edit.
apiVersion: v1
kind: Namespace
metadata:
  name: @NAMESPACE@
  labels:
    chaos.rhiza.io/run: '@RUN_ID@'
    pod-security.kubernetes.io/enforce: 'restricted'
    pod-security.kubernetes.io/enforce-version: 'latest'
  annotations:
    rhiza.dev/auth-owner: '@OWNER@'
    chaos-mesh.org/inject: 'enabled'
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: rhiza-gcs
  namespace: @NAMESPACE@
  annotations:
    iam.gke.io/gcp-service-account: '@POD_GSA@'
    iam.gke.io/return-principal-id-as-email: "true"
automountServiceAccountToken: false
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: rhiza-inspector
  namespace: @NAMESPACE@
automountServiceAccountToken: false
---
# BEGIN LOCAL RUNTIME ACCOUNT
apiVersion: v1
kind: ServiceAccount
metadata:
  name: rhiza-runtime
  namespace: @NAMESPACE@
  annotations:
    rhiza.dev/auth-owner: '@OWNER@'
automountServiceAccountToken: false
---
# END LOCAL RUNTIME ACCOUNT
apiVersion: v1
kind: ResourceQuota
metadata:
  name: rhiza-bounded
  namespace: @NAMESPACE@
spec:
  hard:
    requests.cpu: '2'
    requests.memory: 8Gi
    limits.cpu: '4500m'
    limits.memory: 8Gi
    requests.ephemeral-storage: 8Gi
    limits.ephemeral-storage: 8Gi
    # Three voters, operator and authority are resident, plus the two transient
    # isolation probe Pods: the positive run needs 7, leaving one Pod of headroom.
    pods: '8'
    services: '2'
    services.loadbalancers: '0'
    services.nodeports: '0'
    persistentvolumeclaims: '0'
    count/jobs.batch: '2'
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: @NAMESPACE@-faults
  annotations:
    rhiza.dev/auth-owner: '@OWNER@'
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ['chaos-mesh.org']
        apiVersions: ['v1alpha1']
        operations: ['CREATE', 'UPDATE']
        resources: ['podchaos']
        scope: Namespaced
  variables:
    - name: selector
      expression: object.spec.selector
    - name: sourceSafe
      expression: >-
        has(variables.selector.namespaces) && variables.selector.namespaces == ['@NAMESPACE@'] &&
        has(variables.selector.labelSelectors) && size(variables.selector.labelSelectors) == 3 &&
        'chaos.rhiza.io/run' in variables.selector.labelSelectors && variables.selector.labelSelectors['chaos.rhiza.io/run'] == '@RUN_ID@' &&
        'app.kubernetes.io/part-of' in variables.selector.labelSelectors && variables.selector.labelSelectors['app.kubernetes.io/part-of'] == 'rhiza-chaos' &&
        'statefulset.kubernetes.io/pod-name' in variables.selector.labelSelectors &&
        variables.selector.labelSelectors['statefulset.kubernetes.io/pod-name'] in ['rhiza-voter-0', 'rhiza-voter-1', 'rhiza-voter-2'] &&
        !has(variables.selector.pods) &&
        !has(variables.selector.nodes) && !has(variables.selector.nodeSelectors) &&
        !has(variables.selector.annotationSelectors) && !has(variables.selector.expressionSelectors) &&
        !has(variables.selector.fieldSelectors) && !has(variables.selector.podPhaseSelectors)
  validations:
    - expression: >-
        object.metadata.namespace == '@NAMESPACE@' && has(object.metadata.labels) &&
        'chaos.rhiza.io/run' in object.metadata.labels && object.metadata.labels['chaos.rhiza.io/run'] == '@RUN_ID@' &&
        variables.sourceSafe
      message: Fault metadata and source selector must select only this run's peer Pods.
    # Two correlated full shapes, never a cross-product: the intact-WAL
    # container-kill of voter-0 and the dead-Pod fail-safe pod-kill.
    - expression: >-
        !has(object.spec.remoteCluster) && !has(object.spec.gracePeriod) &&
        has(object.spec.duration) && object.spec.duration == '10s' && !has(object.spec.value) &&
        has(object.spec.mode) && object.spec.mode == 'one' && (
          (object.spec.action == 'container-kill' &&
           has(object.spec.containerNames) && object.spec.containerNames == ['rhiza'] &&
           variables.selector.labelSelectors['statefulset.kubernetes.io/pod-name'] == 'rhiza-voter-0') ||
          (object.spec.action == 'pod-kill' && !has(object.spec.containerNames)))
      message: PodChaos admits only voter-0 container-kill or a dead-Pod pod-kill, ten seconds, one Pod.
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: @NAMESPACE@-faults
  annotations:
    rhiza.dev/auth-owner: '@OWNER@'
spec:
  policyName: @NAMESPACE@-faults
  validationActions: [Deny]
  matchResources:
    namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: @NAMESPACE@
---
# A separate match schema prevents PodChaos-only fields from poisoning CEL
# type checking for NetworkChaos (and vice versa).
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: @NAMESPACE@-network-faults
  annotations:
    rhiza.dev/auth-owner: '@OWNER@'
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - apiGroups: ['chaos-mesh.org']
        apiVersions: ['v1alpha1']
        operations: ['CREATE', 'UPDATE']
        resources: ['networkchaos']
        scope: Namespaced
  variables:
    - name: selector
      expression: object.spec.selector
    # Exactly one of the two correlated sources: the isolated voter or the
    # run's operator Pod. Never a Pod-name selector on the source, never a node
    # or cluster external target.
    - name: selectorIsolatedVoter
      expression: >-
        has(variables.selector.labelSelectors) && size(variables.selector.labelSelectors) == 3 &&
        'chaos.rhiza.io/run' in variables.selector.labelSelectors && variables.selector.labelSelectors['chaos.rhiza.io/run'] == '@RUN_ID@' &&
        'app.kubernetes.io/part-of' in variables.selector.labelSelectors && variables.selector.labelSelectors['app.kubernetes.io/part-of'] == 'rhiza-chaos' &&
        'statefulset.kubernetes.io/pod-name' in variables.selector.labelSelectors && variables.selector.labelSelectors['statefulset.kubernetes.io/pod-name'] == 'rhiza-voter-0'
    - name: selectorOperator
      expression: >-
        has(variables.selector.labelSelectors) && size(variables.selector.labelSelectors) == 2 &&
        'chaos.rhiza.io/run' in variables.selector.labelSelectors && variables.selector.labelSelectors['chaos.rhiza.io/run'] == '@RUN_ID@' &&
        'app' in variables.selector.labelSelectors && variables.selector.labelSelectors['app'] == 'rhiza-operator'
    - name: sourceSafe
      expression: >-
        has(variables.selector.namespaces) && variables.selector.namespaces == ['@NAMESPACE@'] &&
        !has(variables.selector.pods) && !has(variables.selector.nodes) && !has(variables.selector.nodeSelectors) &&
        !has(variables.selector.annotationSelectors) && !has(variables.selector.expressionSelectors) &&
        !has(variables.selector.fieldSelectors) && !has(variables.selector.podPhaseSelectors) &&
        (variables.selectorIsolatedVoter || variables.selectorOperator)
  validations:
    - expression: >-
        object.metadata.namespace == '@NAMESPACE@' && has(object.metadata.labels) &&
        'chaos.rhiza.io/run' in object.metadata.labels && object.metadata.labels['chaos.rhiza.io/run'] == '@RUN_ID@' &&
        variables.sourceSafe
      message: Fault metadata and source selector must select only this run's peer Pods.
    # Two correlated full shapes, never a cross-product of source, window and
    # target. Shape A isolates voter-0 for 45s against voters 1 and 2 only.
    # Shape B partitions the operator from every voter for 60s.
    - expression: >-
        object.spec.action == 'partition' && has(object.spec.direction) && object.spec.direction == 'both' &&
        !has(object.spec.externalTargets) && !has(object.spec.device) && !has(object.spec.delay) &&
        !has(object.spec.loss) && !has(object.spec.duplicate) && !has(object.spec.corrupt) &&
        !has(object.spec.bandwidth) && !has(object.spec.rate) &&
        !has(object.spec.remoteCluster) && !has(object.spec.targetDevice) &&
        has(object.spec.target) && has(object.spec.target.mode) && object.spec.target.mode == 'all' &&
        !has(object.spec.target.value) && has(object.spec.target.selector) &&
        has(object.spec.target.selector.namespaces) && object.spec.target.selector.namespaces == ['@NAMESPACE@'] &&
        has(object.spec.target.selector.labelSelectors) && size(object.spec.target.selector.labelSelectors) == 2 &&
        'chaos.rhiza.io/run' in object.spec.target.selector.labelSelectors && object.spec.target.selector.labelSelectors['chaos.rhiza.io/run'] == '@RUN_ID@' &&
        'app' in object.spec.target.selector.labelSelectors && object.spec.target.selector.labelSelectors['app'] == 'rhiza-voter' &&
        !has(object.spec.target.selector.pods) &&
        !has(object.spec.target.selector.nodes) && !has(object.spec.target.selector.nodeSelectors) &&
        !has(object.spec.target.selector.annotationSelectors) &&
        !has(object.spec.target.selector.fieldSelectors) && !has(object.spec.target.selector.podPhaseSelectors) &&
        has(object.spec.duration) && !has(object.spec.value) && (
          (object.spec.duration == '45s' && object.spec.mode == 'one' &&
           variables.selectorIsolatedVoter &&
           has(object.spec.target.selector.expressionSelectors) &&
           size(object.spec.target.selector.expressionSelectors) == 1 &&
           object.spec.target.selector.expressionSelectors[0].key == 'statefulset.kubernetes.io/pod-name' &&
           object.spec.target.selector.expressionSelectors[0].operator == 'In' &&
           size(object.spec.target.selector.expressionSelectors[0].values) == 2 &&
           'rhiza-voter-1' in object.spec.target.selector.expressionSelectors[0].values &&
           'rhiza-voter-2' in object.spec.target.selector.expressionSelectors[0].values) ||
          (object.spec.duration == '60s' && object.spec.mode == 'all' &&
           variables.selectorOperator &&
           !has(object.spec.target.selector.expressionSelectors)))
      message: NetworkChaos admits only voter-0 isolation or the operator whole-generation partition.
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: @NAMESPACE@-network-faults
  annotations:
    rhiza.dev/auth-owner: '@OWNER@'
spec:
  policyName: @NAMESPACE@-network-faults
  validationActions: [Deny]
  matchResources:
    namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: @NAMESPACE@
---
# Bootstrap-owned isolation is installed before the runtime credential exists.
# The runtime identity may observe this exact policy but cannot mutate any
# NetworkPolicy or add an overlapping allow policy.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: rhiza-inspector-deny-all
  namespace: @NAMESPACE@
  labels: {chaos.rhiza.io/run: '@RUN_ID@', app: 'rhiza-inspector'}
  annotations: {rhiza.dev/auth-owner: '@OWNER@'}
spec:
  podSelector:
    matchLabels: {chaos.rhiza.io/run: '@RUN_ID@', app: 'rhiza-inspector'}
  policyTypes: [Ingress, Egress]
  ingress: []
  egress: []
---
# Only the selected runtime identity, not the Pod GSA/KSA, controls this scope.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: rhiza-ci-runtime
  namespace: @NAMESPACE@
rules:
  - apiGroups: ['']
    resources: [pods, configmaps, services]
    verbs: [create, get, list, watch, delete]
  - apiGroups: ['']
    resources: [serviceaccounts]
    resourceNames: [rhiza-inspector]
    verbs: [get]
  - apiGroups: [rbac.authorization.k8s.io]
    resources: [rolebindings]
    verbs: [list]
  - apiGroups: ['']
    resources: [pods/log]
    verbs: [get]
  - apiGroups: ['']
    resources: [pods/exec, pods/portforward]
    verbs: [create]
  - apiGroups: ['']
    resources: [events]
    verbs: [get, list, watch]
  - apiGroups: ['']
    resources: [endpoints]
    verbs: [get, list, watch]
  - apiGroups: [batch]
    resources: [jobs]
    verbs: [create, get, list, watch, delete]
  - apiGroups: [batch]
    resources: [cronjobs]
    verbs: [list]
  - apiGroups: [apps]
    resources: [statefulsets]
    verbs: [create, get, list, watch, delete]
  - apiGroups: [apps]
    resources: [deployments, replicasets, daemonsets]
    verbs: [list]
  - apiGroups: [apps]
    resources: [statefulsets/scale]
    verbs: [get, update, patch]
  - apiGroups: [networking.k8s.io]
    resources: [networkpolicies]
    verbs: [get, list, watch]
  - apiGroups: [discovery.k8s.io]
    resources: [endpointslices]
    verbs: [get, list, watch]
  - apiGroups: [chaos-mesh.org]
    resources: [podchaos, networkchaos]
    verbs: [create, get, list, watch, delete]
  - apiGroups: [rhiza.mrchypark.dev]
    resources: [rhizaclusters, rhizafences, rhizarecoveries]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: rhiza-ci-runtime
  namespace: @NAMESPACE@
subjects:
  - kind: @RUNTIME_KIND@
@RUNTIME_API_GROUP@
    name: '@RUNTIME_NAME@'
@RUNTIME_NAMESPACE@
roleRef:
  kind: Role
  apiGroup: rbac.authorization.k8s.io
  name: rhiza-ci-runtime
---
# Cluster-scoped reads: exact fresh namespace and four safe default RBAC roles.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: @NAMESPACE@-reader
  annotations:
    rhiza.dev/auth-owner: '@OWNER@'
rules:
  - apiGroups: ['']
    resources: [namespaces]
    resourceNames: ['@NAMESPACE@']
    verbs: [get]
  - apiGroups: [rbac.authorization.k8s.io]
    resources: [clusterrolebindings]
    verbs: [list]
  - apiGroups: [rbac.authorization.k8s.io]
    resources: [clusterroles]
    resourceNames: [system:basic-user, system:discovery, system:public-info-viewer, system:service-account-issuer-discovery]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: @NAMESPACE@-reader
  annotations:
    rhiza.dev/auth-owner: '@OWNER@'
subjects:
  - kind: @RUNTIME_KIND@
@RUNTIME_API_GROUP@
    name: '@RUNTIME_NAME@'
@RUNTIME_NAMESPACE@
roleRef:
  kind: ClusterRole
  apiGroup: rbac.authorization.k8s.io
  name: @NAMESPACE@-reader
